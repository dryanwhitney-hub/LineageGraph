{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LineageGraph",
  "version": "0.2.0",
  "identifier": "com.david-whitney.lineagegraph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LineageGraph",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright © 2026 David Whitney",
    "shortDescription": "LineageGraph - Stammbaum- und Ahnenforschungssoftware",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNzI2QTY5MUIwNjYyMEQKUldRTllnWWJhV3B5T21iYXVwVys2TDArK09UZHNEcEZwaEhrS2FMZ2Vycy9VSHBqRy9CTStkcFUK",
      "endpoints": [
        "https://github.com/david-whitney/LineageGraph/releases/latest/download/latest.json"
      ]
    }
  }
}
